CXX = g++
EXEC_file = run.out

#=================================
# Compilation options, maybe to be added later
DEBUG = YES

#=================================
# Windows cross-compiler settings
CXX_WIN = x86_64-w64-mingw32-g++
EXEC_FILE_WIN = run.exe

#=================================
# Default rayulib flags
CXXFLAGS = -lraylib -lGL -lm -lpthread -ldl -lrt -lX11
CXXFLAGS_WIN = -lraylib -lgdi32 -lopengl32 -lwinmm

#=================================
# Directories and flags

ifeq ($(DEBUG),YES)
	EXEC_DIR = ./../bin/debug
	CXXFLAGS += -g -Wall
	CXXFLAGS_WIN += -g -Wall
else
	EXEC_DIR = ./../bin/release
	CXXFLAGS += -O3 -Wall
	CXXFLAGS_WIN += -O3 -Wall
endif

SRC = $(wildcard *.cpp)
OBJ = $(patsubst %.cpp, %.o, $(SRC))

#=================================
# Rules
all: linux

linux: $(EXEC_DIR)/$(EXEC_file)

windows: $(EXEC_DIR)/$(EXEC_FILE_WIN)

$(EXEC_DIR)/$(EXEC_file): $(OBJ)
	@mkdir -p $(EXEC_DIR)
	$(CXX) $(OBJ) $(CXXFLAGS) -o $(EXEC_DIR)/$(EXEC_file)

$(EXEC_DIR)/$(EXEC_FILE_WIN): $(OBJ)
	@mkdir -p $(EXEC_DIR)
	$(CXX_WIN) $(OBJ) $(CXXFLAGS_WIN) -o $(EXEC_DIR)/$(EXEC_FILE_WIN)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ) $(EXEC_DIR)/$(EXEC_file) $(EXEC_DIR)/$(EXEC_FILE_WIN)

.PHONY: all clean linux windows
